{
  "components": {
    "schemas": {
      "EngineView": {
        "properties": {
          "id": {
            "description": "Stable short name, e.g. decimer-segmentation.",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Git commit the version was built from, when it is not a release.",
            "title": "Revision"
          },
          "role": {
            "description": "What it does here, e.g. segmentation, ocsr, naming.",
            "title": "Role",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "version"
        ],
        "title": "EngineView",
        "type": "object"
      },
      "EnginesView": {
        "properties": {
          "engines": {
            "items": {
              "$ref": "#/components/schemas/EngineView"
            },
            "title": "Engines",
            "type": "array"
          }
        },
        "required": [
          "engines"
        ],
        "title": "EnginesView",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "empty_upload",
          "too_many_files",
          "unsupported",
          "mixed_upload",
          "multiple_pdfs",
          "corrupt_file",
          "encrypted_pdf",
          "too_many_pixels",
          "processing_limit",
          "too_large",
          "invalid_request",
          "rate_limited",
          "queue_full",
          "busy",
          "unavailable",
          "not_found",
          "no_results",
          "method_not_allowed",
          "http_error",
          "internal_error"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ExportFormat": {
        "enum": [
          "zip",
          "sdf",
          "csv"
        ],
        "title": "ExportFormat",
        "type": "string"
      },
      "ExportRequest": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "$ref": "#/components/schemas/ExportFormat"
          },
          "molfiles": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Edited molfiles keyed by result index (0-based, as a decimal string). A result that is not listed is exported as the server has it. The order of the export is the job's, never the request's.",
            "title": "Molfiles",
            "type": "object"
          }
        },
        "required": [
          "format"
        ],
        "title": "ExportRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobStatus": {
        "enum": [
          "queued",
          "running",
          "done",
          "failed"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "JobView": {
        "description": "The job as the API returns it.",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when `status` is failed.",
            "title": "Error"
          },
          "expiresAt": {
            "description": "When the job and its files are deleted.",
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "pages": {
            "description": "Pages in the upload (an image counts as one page).",
            "title": "Pages",
            "type": "integer"
          },
          "pagesProcessed": {
            "description": "Pages that will be, or were, processed.",
            "title": "Pagesprocessed",
            "type": "integer"
          },
          "queuePosition": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "1-based place in the queue while `status` is queued.",
            "title": "Queueposition"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ResultView"
            },
            "title": "Results",
            "type": "array"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/Stage"
            },
            "title": "Stages",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "structuresDropped": {
            "default": 0,
            "description": "Found but not returned (the cap).",
            "title": "Structuresdropped",
            "type": "integer"
          },
          "structuresFound": {
            "default": 0,
            "title": "Structuresfound",
            "type": "integer"
          },
          "truncated": {
            "description": "A page or structure limit cut the job short.",
            "title": "Truncated",
            "type": "boolean"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/JobWarning"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "id",
          "status",
          "stages",
          "pages",
          "pagesProcessed",
          "truncated",
          "createdAt",
          "expiresAt"
        ],
        "title": "JobView",
        "type": "object"
      },
      "JobWarning": {
        "description": "A machine-readable code (the UI picks the wording) and an English fallback message.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "JobWarning",
        "type": "object"
      },
      "ReportRequest": {
        "additionalProperties": false,
        "properties": {
          "index": {
            "description": "0-based index of the result the problem is about.",
            "minimum": 0.0,
            "title": "Index",
            "type": "integer"
          }
        },
        "required": [
          "index"
        ],
        "title": "ReportRequest",
        "type": "object"
      },
      "ResultView": {
        "description": "A result as returned by the API.",
        "properties": {
          "bbox": {
            "description": "[x0, y0, x1, y1] in pixels of the rendered page.",
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Bbox",
            "type": "array"
          },
          "confidence": {
            "description": "Recognition confidence.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "cropUrl": {
            "description": "URL of the crop image of this result.",
            "title": "Cropurl",
            "type": "string"
          },
          "inchikey": {
            "description": "Empty when the SMILES is invalid.",
            "title": "Inchikey",
            "type": "string"
          },
          "index": {
            "description": "0-based position in the job; edits and exports use it.",
            "minimum": 0.0,
            "title": "Index",
            "type": "integer"
          },
          "isStructure": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "The classifier believes this is a chemical structure. Null when the classifier gave no answer (the worker could not reach it).",
            "title": "Isstructure"
          },
          "molfile": {
            "default": "",
            "description": "V2000 molfile with 2D coordinates: RDKit's, or CDK's when `validBy` is cdk.",
            "title": "Molfile",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "IUPAC name that passed the round trip.",
            "title": "Name"
          },
          "nameTier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tier of `name`, e.g. pin_verified.",
            "title": "Nametier"
          },
          "nameVerified": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "How `name` was checked, as chem reports it (e.g. opsin); null without a name.",
            "title": "Nameverified"
          },
          "number": {
            "description": "1-based compound number shown in the UI.",
            "readOnly": true,
            "title": "Number",
            "type": "integer"
          },
          "pageIndex": {
            "description": "0-based page the structure was found on.",
            "minimum": 0.0,
            "title": "Pageindex",
            "type": "integer"
          },
          "smiles": {
            "title": "Smiles",
            "type": "string"
          },
          "svg": {
            "default": "",
            "description": "RDKit depiction as an inline SVG string.",
            "title": "Svg",
            "type": "string"
          },
          "valid": {
            "description": "RDKit accepts the SMILES.",
            "title": "Valid",
            "type": "boolean"
          },
          "validBy": {
            "anyOf": [
              {
                "enum": [
                  "rdkit",
                  "cdk"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Who accepted the SMILES: `rdkit` (then `valid` is true), `cdk` (RDKit refused it, CDK read it: `valid` is false, `molfile` and `svg` are CDK's reading) or null (neither). Equals `rdkit` for every valid result.",
            "title": "Validby"
          }
        },
        "required": [
          "index",
          "pageIndex",
          "bbox",
          "smiles",
          "inchikey",
          "valid",
          "isStructure",
          "confidence",
          "cropUrl",
          "number"
        ],
        "title": "ResultView",
        "type": "object"
      },
      "Stage": {
        "properties": {
          "name": {
            "$ref": "#/components/schemas/StageName"
          },
          "state": {
            "$ref": "#/components/schemas/StageState"
          }
        },
        "required": [
          "name",
          "state"
        ],
        "title": "Stage",
        "type": "object"
      },
      "StageName": {
        "enum": [
          "upload",
          "render",
          "segment",
          "recognise",
          "check"
        ],
        "title": "StageName",
        "type": "string"
      },
      "StageState": {
        "enum": [
          "pending",
          "active",
          "done"
        ],
        "title": "StageState",
        "type": "string"
      },
      "ValidateRequest": {
        "additionalProperties": false,
        "properties": {
          "molfile": {
            "description": "The edited structure, as the editor writes it (V2000/V3000).",
            "title": "Molfile",
            "type": "string"
          }
        },
        "required": [
          "molfile"
        ],
        "title": "ValidateRequest",
        "type": "object"
      },
      "ValidateView": {
        "description": "What the server computes for an edited structure: the same values the worker computes for a\nrecognised one, so the screen and the export agree (`chemistry.py`).",
        "properties": {
          "inchikey": {
            "description": "Empty when the structure is not valid or has no InChI.",
            "title": "Inchikey",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "IUPAC name that passed the round trip; null when none.",
            "title": "Name"
          },
          "nameTier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tier of `name`.",
            "title": "Nametier"
          },
          "nameVerified": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "How `name` was checked.",
            "title": "Nameverified"
          },
          "smiles": {
            "description": "Canonical SMILES. Empty when the structure is not valid.",
            "title": "Smiles",
            "type": "string"
          },
          "svg": {
            "description": "RDKit depiction as an inline SVG string. For a structure RDKit reads but will not sanitize (`valid` false) it is the drawing of the molfile as it is; empty when the molfile has no atoms or the drawing fails.",
            "title": "Svg",
            "type": "string"
          },
          "valid": {
            "description": "RDKit accepts the structure and it has at least one atom.",
            "title": "Valid",
            "type": "boolean"
          }
        },
        "required": [
          "smiles",
          "inchikey",
          "svg",
          "valid"
        ],
        "title": "ValidateView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "DECIMER.ai job API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/engines": {
      "get": {
        "operationId": "get_engines_api_engines_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnginesView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The versions of the models and libraries behind the results"
      }
    },
    "/api/jobs": {
      "post": {
        "operationId": "create_job_api_jobs_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "description": "One PDF, or one or more PNG, JPEG, WebP or HEIC images. A pasted image is one part.",
                    "items": {
                      "format": "binary",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Mixed PDF and images, several PDFs, a corrupt or encrypted file, or no file"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The upload, an image or a PDF page is too large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A file is not a PDF, PNG, JPEG, WebP or HEIC/HEIF image"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The client already has the maximum number of active jobs"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The queue is full, or the service is unavailable. See Retry-After"
          }
        },
        "summary": "Create a job from an upload or a pasted image"
      }
    },
    "/api/jobs/{job_id}": {
      "delete": {
        "description": "For a user who starts over: the job stops counting against the client's limit at once. A\nqueued job is never started; a running one is stopped by its worker within a few seconds\n(`worker/cancel.py`); a finished one loses its files before the hour is up. The job answers\n404 from then on.",
        "operationId": "delete_job_api_jobs__job_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown or expired job"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete a job: stop it, free the client's slot, remove its files"
      },
      "get": {
        "operationId": "get_job_api_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown or expired job"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Status, progress and results of a job"
      }
    },
    "/api/jobs/{job_id}/export": {
      "post": {
        "operationId": "export_job_api_jobs__job_id__export_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/zip": {},
              "chemical/x-mdl-sdfile": {},
              "text/csv; charset=utf-8": {}
            },
            "description": "The file. A ZIP has each structure's crop image and `.mol` file, and `results.smiles.txt` (image, SMILES, IUPAC name), in result order."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown or expired job, or no such result"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The job has no structures to export"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request is too large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request is not valid, or a molfile cannot be read"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests from this client. See Retry-After"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The service is unavailable. See Retry-After"
          }
        },
        "summary": "Download a job's structures as a ZIP, an SDF or a CSV, with the user's edits"
      }
    },
    "/api/jobs/{job_id}/media/{name}": {
      "get": {
        "operationId": "get_media_api_jobs__job_id__media__name__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {}
            },
            "description": "The image (crop-N.png or page-N.png)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown job or file"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "A crop or page image of a job"
      }
    },
    "/api/jobs/{job_id}/report": {
      "post": {
        "description": "Keeps the result and its crop image on the private reports volume until someone has looked\nat them. Only the index comes from the client. A result reported twice is kept once.",
