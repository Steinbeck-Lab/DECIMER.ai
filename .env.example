# Copy to .env for local runs. Never commit .env (see .gitignore).
# Values below are the limits in docs/ROADMAP.md §3.

REDIS_URL=redis://redis:6379/0
JOB_TTL_SECONDS=3600
MAX_PDF_PAGES=10
MAX_STRUCTURES=20
MAX_UPLOAD_MB=100
MAX_ACTIVE_JOBS_PER_IP=2
# The addresses of the reverse proxies whose X-Forwarded-For is believed (comma or space
# separated). List proxy addresses, not client networks: every host inside a listed network
# can choose the address its limits are counted against. /0 is refused; anything wider than
# /24 (IPv4) or /64 (IPv6) logs a warning. Behind docker, include the nginx container's network
# as well as the campus proxy. Empty trusts nobody (the TCP peer is the client).
TRUSTED_PROXY_CIDR=
# Sentry or GlitchTip DSN; empty disables error reporting.
SENTRY_DSN=

# --- API job core (api/README.md has the full table) ---

# Where job files live: DATA_DIR/<job id>/. A volume shared with nginx (X-Accel-Redirect).
DATA_DIR=/data/jobs
# Jobs allowed to wait; at this many, new jobs get 503 with Retry-After.
QUEUE_MAX=50
# Record lifetimes (seconds): a queued job waits at most this long; a running job must be saved
# again within this long (the worker saves after every stage); a finished job lasts
# JOB_TTL_SECONDS. An upload that dies without releasing its slot is forgotten after the
# reservation TTL.
QUEUED_JOB_TTL_SECONDS=21600
RUNNING_JOB_TTL_SECONDS=1200
RESERVATION_TTL_SECONDS=600
# The sweep leaves folders younger than this alone when they have no record yet (an upload in
# progress). Run: python -m decimer_api.sweep --every 300
SWEEP_GRACE_SECONDS=900
# Upload hardening. Pixel limits: 50 MP is a B2 page at 300 DPI (A2 is 34.8 MP); a job may hold
# 10 such pages. Every upload is parsed in a child process with these limits.
MAX_UPLOAD_FILES=50
MAX_IMAGE_PIXELS=50000000
MAX_JOB_PIXELS=500000000
# At least 2: one client may use only one ingest at a time.
INGEST_CONCURRENCY=2
# Seconds a request may wait for its ingest turn, and the deadline of one ingest child process.
# Wait + deadline + 5 s must stay below PROXY_READ_TIMEOUT_SECONDS (the API refuses to start
# otherwise); set that to your nginx proxy_read_timeout (default 60 s).
INGEST_WAIT_SECONDS=20
INGEST_TIMEOUT_SECONDS=30
PROXY_READ_TIMEOUT_SECONDS=60
# Address space (MB) a child may allocate beyond what it uses after start-up.
INGEST_MEMORY_MB=1536
# Retry-After (seconds) of 503 answers for a full queue or a busy service.
QUEUE_RETRY_AFTER_SECONDS=30
# Key for hashing client addresses. Set it in production: without it a random key is made at
# start, so per-IP counters reset on restart and are not shared between processes.
IP_HASH_SECRET=
# true streams media files from the API (development); false hands them to nginx with
# X-Accel-Redirect to MEDIA_ACCEL_PREFIX.
MEDIA_STREAM_DIRECT=false
MEDIA_ACCEL_PREFIX=/_protected/jobs
# python -m decimer_api (containers need HOST=0.0.0.0)
HOST=127.0.0.1
PORT=8000

# --- Validate, export, report (api/README.md, "Results") ---

# The api asks the chem service (CHEM_URL, below: the api reads the same variable) for the IUPAC name of
# an edited structure, for at most this long and with no retry; a name that is late is null. The api keeps
# one call in flight to chem, and a validate that finds it occupied answers with no name: the worker has
# priority on chem.
NAMES_TIMEOUT_SECONDS=4
# Child processes that read client molfiles (the api never runs RDKit's parser itself), and ZIP downloads
# streamed at once; the next request gets 503 busy.
MAX_CONCURRENT_ANALYSES=2
MAX_CONCURRENT_DOWNLOADS=8
# Of those, what one client address may have going (429 beyond), and the most one download may take (seconds):
# a client that stops reading is cut off after it, and its place and files are freed.
MAX_DOWNLOADS_PER_CLIENT=2
DOWNLOAD_TIMEOUT_SECONDS=120
# A molfile-reading child: memory it may allocate beyond what RDKit maps (MB, address-space limit), seconds
# for one molfile, for all the edits of an export, to start, and the number of molfiles after which it is
# replaced. About 70 MB resident each; at the limit about 450 MB each.
ANALYSIS_MEMORY_MB=384
ANALYSIS_TIMEOUT_SECONDS=5
ANALYSIS_BATCH_SECONDS=20
ANALYSIS_STARTUP_SECONDS=30
ANALYSIS_RECYCLE_AFTER=500
# A client that deletes a running job keeps its slot this long, whatever the worker does
# (CANCEL_POLL_SECONDS + the longest model-service timeout: what an abandoned call can go on computing).
CANCELLING_SLOT_SECONDS=185
# The largest molfile a client may send (bytes). 413 above it.
MAX_MOLFILE_BYTES=65536
# Requests per client address in a fixed window (429 with Retry-After beyond it).
VALIDATE_RATE_PER_MINUTE=60
EXPORT_RATE_PER_MINUTE=10
REPORT_RATE_PER_HOUR=30
# Problem reports: a private volume only the api mounts. At most MAX_REPORTS folders; a crop image over
# MAX_REPORT_IMAGE_BYTES is left out of its report.
REPORTS_DIR=/data/reports
MAX_REPORTS=5000
# ... and the bytes of all reports together (counted from the disk): 503 beyond, a warning at 80 %.
REPORTS_MAX_BYTES=2147483648
MAX_REPORT_IMAGE_BYTES=4194304

# --- Worker (api/README.md, "Worker") ---

# Base URLs of the model services; the worker adds /infer (or /names for chem).
SEG_URL=http://seg:8001
OCSR_URL=http://ocsr:8002
CLS_URL=http://cls:8003
# Optional: the chem service (IUPAC names), read by the worker and by the api. Empty means every name is null.
CHEM_URL=
# Calls in flight at once to ONE REPLICA of each model service, counted over all jobs of this
# worker process. The worker finds all replicas of a service through DNS (one host name per service, all
# replicas answer on its port), sends each call to the least-busy healthy one and multiplies: 3 ocsr
# replicas take 3 x OCSR_CONCURRENCY calls. A replica runs one inference at a time (ocsr: 3 s for a
# structure, up to 55 s for an image that is not one), so 1 keeps it fed. A URL whose host is an IP
# address or localhost is one replica (nothing is looked up), and so is a name that does not resolve.
SEG_CONCURRENCY=1
OCSR_CONCURRENCY=1
CLS_CONCURRENCY=1
CHEM_CONCURRENCY=1
# Jobs one worker process runs at once; pages rendered at once. Several jobs share the replicas: a small
# job's calls go first, jobs take turns, and a stream of small jobs cannot starve a big one.
WORKER_MAX_JOBS=4
RENDER_CONCURRENCY=1
# Replicas are looked up again this often (seconds) and at once after a connection failed; a replica that
# refused a connection is skipped this long; after this many calls of small jobs in a row a waiting call
# of a large job gets the next free slot.
REPLICA_REFRESH_SECONDS=10
REPLICA_COOLDOWN_SECONDS=10
SMALL_FIRST_BURST=4
# The fast lane: a job of at most SMALL_JOB_MAX_PAGES processed pages (a pasted image, a single image, a
# one-page PDF; 0 = none) goes to the fast queue when a fast worker is alive (it serves the queue named by
# ITS WORKER_QUEUE_NAME), else to the default queue. The default worker moves jobs stranded on the fast
# queue to its own every FAST_LANE_RESCUE_SECONDS when no fast worker is alive (0 = never).
WORKER_QUEUE_NAME=arq:queue
WORKER_FAST_QUEUE_NAME=decimer:fast
SMALL_JOB_MAX_PAGES=1
FAST_LANE_RESCUE_SECONDS=30
# Read timeouts per call (seconds), and the limit for one whole job. At start the worker checks
# that PIPELINE_TIMEOUT_SECONDS + 60 < RUNNING_JOB_TTL_SECONDS and HEARTBEAT_SECONDS <= a quarter
# of it; to allow longer jobs, raise both.
SEG_TIMEOUT_SECONDS=180
OCSR_TIMEOUT_SECONDS=120
CLS_TIMEOUT_SECONDS=60
CHEM_TIMEOUT_SECONDS=120
PIPELINE_TIMEOUT_SECONDS=1000
HEARTBEAT_SECONDS=60
# A running job is checked this often for having been deleted by its owner (DELETE /api/jobs/<id>).
CANCEL_POLL_SECONDS=2
# After this many ocsr timeouts in one job, the job fails with service_unavailable.
OCSR_MAX_TIMEOUTS=3
# Retries: a 503 waits Retry-After (capped) up to BUSY_RETRIES times; a service that cannot be
# connected to is retried with doubling backoff until CONNECT_RETRY_BUDGET_SECONDS of waiting
# (ocsr needs about 50 s to load); a connection that broke after the request went out is retried once.
BUSY_RETRIES=3
CONNECT_RETRY_BUDGET_SECONDS=90
SENT_RETRIES=1
# D4: the CDK fallback stays off until the golden-set data says otherwise.
CDK_FALLBACK=false
