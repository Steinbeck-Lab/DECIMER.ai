# Settings of the new stack's Compose project. Copy to deploy/.env (docker compose reads it for ${VAR}
# in compose.yaml and passes it as env_file to api, worker and sweep). Never commit deploy/.env: it
# holds secrets, and the repository's .gitignore already excludes it. chmod 600.
#
# This file lists what a deployment sets or may want to change. The API's and the worker's own
# settings, with their meaning and defaults, are in api/README.md and the repository's .env.example;
# any of them can be added here and reaches the api, worker and sweep containers unchanged. Values
# that compose.yaml fixes for the container (REDIS_URL, DATA_DIR, HOST, PORT, MEDIA_STREAM_DIRECT, the
# model service URLs, the api's TRUSTED_PROXY_CIDR, PROXY_READ_TIMEOUT_SECONDS and MAX_UPLOAD_MB) are
# set there, so setting them here has no effect on the api (and IP_HASH_SECRET reaches the api only).

# --- required secrets ---------------------------------------------------------------------------
# Key for hashing client addresses (the API keeps no raw addresses). Without it the per-IP counters
# reset on every restart. Generate once: openssl rand -hex 32
IP_HASH_SECRET=
# Redis password. It goes into REDIS_URL (a URL) and a Redis config line, so use hex:
# openssl rand -hex 24
REDIS_PASSWORD=

# --- proxies ------------------------------------------------------------------------------------
# THE CAMPUS PROXIES in front of the edge, whose X-Forwarded-For the edge believes (comma or space
# separated; TODO Q3: empty until their addresses are known). LIST PROXY ADDRESSES, NOT CLIENT
# NETWORKS: every host inside a listed network can choose the address its limits are counted against;
# /0 is refused. Do not list the docker networks here: compose adds the public network's subnet for
# the edge by itself, and gives the API the app network's subnet (the edge is its peer) from APP_SUBNET.
# With nothing listed, every client behind the campus proxy shares one limit.
# Before the beta, check what the proxy sends (does it append to X-Forwarded-For, or replace it?):
# see deploy/README.md, "Before /beta".
TRUSTED_PROXY_CIDR=
# Subnets of the two pinned networks. Change them only if one collides with a route on the VM
# (legacy uses 172.18.0.0/16; docker's default pool is 172.16.0.0/12). They must not overlap.
#   PUBLIC_SUBNET: the edge alone (the published port, the legacy nginx during the beta)
#   APP_SUBNET:    edge + api; it is the API's TRUSTED_PROXY_CIDR, derived from this one variable
PUBLIC_SUBNET=172.29.80.0/28
APP_SUBNET=172.29.80.16/28
# nginx proxy_read_timeout, and the value the API checks its ingest budget against:
# INGEST_WAIT_SECONDS (20) + INGEST_TIMEOUT_SECONDS (30) + 5 s must stay below it, or the API refuses
# to start. The front door (the legacy nginx during the beta) should wait a little longer (65).
PROXY_READ_TIMEOUT_SECONDS=60

# --- publishing ---------------------------------------------------------------------------------
# The edge listens on 127.0.0.1:<EDGE_PORT> only (the legacy site has 8080).
EDGE_PORT=8090

# --- images -------------------------------------------------------------------------------------
# Tag of every image the project builds (localhost/decimer-next/{api,seg,cls,ocsr,chem,edge}:<tag>).
# The images are never pulled (pull_policy: never, and a localhost/ name). Use a release name or a
# date so that the previous images stay around for a rollback.
DECIMER_TAG=local
# `http` is the real API client of the app (still TODO); `mock` builds a demo UI on canned data.
VITE_API=http
# 1: install libgl1 and libglib2.0-0 in the seg and ocsr images. Only until
# deploy/patches/apply-pyproject-patches.sh has been applied to services/seg and services/ocsr.
OPENCV_GUI_LIBS=0

# --- model services: replicas, threads, CPU ----------------------------------------------
# Replica counts. seg, ocsr and cls run as N identical containers; the service name (seg, ocsr, cls)
# resolves to all of them and the worker balances across the addresses. chem is always 1.
# Everything below that says "per replica" is per container. Two layouts, with the reasoning and the
# memory and thread budget in deploy/README.md ("Replicas, threads and memory"):
#
#   BESIDE LEGACY (the default: local testing, the beta; legacy keeps its 22 GB and its CPU):
SEG_REPLICAS=2
OCSR_REPLICAS=2
CLS_REPLICAS=2
#   compute threads per replica (TensorFlow intra-op; OMP/OpenBLAS/MKL/numba follow) and the CPU limit
#   of the container. seg and cls: the thread count plus half a core for TensorFlow's other threads
#   (2 + 0.5, 1 + 0.5); ocsr: the thread count itself (2), it decodes token by token and uses about the cap.
#   The _CPUS values do NOT follow the thread counts by themselves: change both by hand, together.
SEG_TF_INTRAOP_THREADS=2
SEG_CPUS=2.5
OCSR_TF_INTRAOP_THREADS=2
OCSR_CPUS=2
CLS_TF_INTRAOP_THREADS=1
CLS_CPUS=1.5
#
#   AFTER CUTOVER (legacy removed, 6 seg + 3 ocsr + 3 cls like legacy's socket servers): replace the
#   block above by these values (the worker lines below change with it):
#     SEG_REPLICAS=6        SEG_TF_INTRAOP_THREADS=1   SEG_CPUS=1.5
#     OCSR_REPLICAS=3       OCSR_TF_INTRAOP_THREADS=2  OCSR_CPUS=2
#     CLS_REPLICAS=3        CLS_TF_INTRAOP_THREADS=1   CLS_CPUS=1.5
#     WORKER_MAX_JOBS=8     RENDER_CONCURRENCY=2       WORKER_MEM_LIMIT=3g
#   (SEG/OCSR/CLS_CONCURRENCY stay at 1: they are per replica and the worker multiplies, see below.)
#
# TensorFlow inter-op threads, one per replica in both layouts (the models are single sequences of ops):
#SEG_TF_INTEROP_THREADS=1
#OCSR_TF_INTEROP_THREADS=1
#CLS_TF_INTEROP_THREADS=1
# Do NOT raise this: seg refuses pages above 40 MP, and the worker is to downscale pages for it
# (TODO; deploy/README.md, "Dependencies"). Raising it needs a bigger seg memory limit first.
#SEG_MAX_IMAGE_PIXELS=40000000
# The chem service (Orthonym names); one replica. `CHEM_URL=` (empty) switches names off ("no verified name");
# compose uses its default http://chem:8004 only when the variable is unset (no line at all).
CHEM_URL=http://chem:8004
# D4 (kept): the worker sends the SMILES that RDKit refuses to chem's POST /cdk (CDK 2.8, legacy's version), one batch
# per job; a structure only CDK accepts is shown as "accepted by CDK only". It needs chem (CHEM_URL) and costs one more
# request to it per job that has such a structure. false: no call.
CDK_FALLBACK=true

# --- worker -------------------------------------------------------------------------------------
# Calls in flight at once to ONE REPLICA of a model service. The worker looks up all the replicas
# of a service by its name, sends each call to the least-busy healthy one and multiplies: with 3 ocsr
# replicas it keeps up to 3 x OCSR_CONCURRENCY calls going. Each replica runs one inference at a time
# and queues a few more, so 1 keeps it fed without filling its queue, in both layouts (2/2/2 and 6/3/3).
# Do not set them to the replica counts. (Before P3-04b they were service totals, 2 each.)
SEG_CONCURRENCY=1
OCSR_CONCURRENCY=1
CLS_CONCURRENCY=1
CHEM_CONCURRENCY=1
# Jobs the worker runs at once (arq max_jobs), so that crops of several jobs interleave on the replicas
# (a small job's calls go first, jobs take turns, and a stream of small jobs cannot starve a big one). Each
# running job holds little memory: a page image is held only while it has a seg slot (at most 2 beside
# legacy, 6 after cutover, in the whole process); the rendering of PDF pages is what costs,
# RENDER_CONCURRENCY pages of up to about 0.5 GB at a time. About twice the ocsr slots: beside legacy 4 jobs and 1 render; after cutover
# 8 and 2, with WORKER_MEM_LIMIT=3g. With the fast lane off, this is also how many big PDFs can run before
# a small job has to wait for a place.
WORKER_MAX_JOBS=4
RENDER_CONCURRENCY=1
#WORKER_MEM_LIMIT=2g
#WORKER_CPUS=2
# Seconds arq waits for running jobs when the worker is stopped (compose waits 120 s before it kills).
#SHUTDOWN_WAIT_SECONDS=100
# Replica discovery and fair dispatching (worker defaults shown; rarely worth changing):
# how often the names are looked up again (a connection failure looks them up at once), how long a
# replica that refused a connection is skipped, and how many calls of small jobs in a row may go before
# a waiting call of a large job gets the next free slot (the bound that keeps big jobs from starving).
#REPLICA_REFRESH_SECONDS=10
#REPLICA_COOLDOWN_SECONDS=10
#SMALL_FIRST_BURST=4

# --- the fast lane: a second queue for small jobs (TODO, D18) ---------------------------------
# A small job (a pasted image, a single image upload or a PDF of at most SMALL_JOB_MAX_PAGES pages, 1)
# goes to its own arq queue and its own worker (`worker-fast`, part of the default start, 1 GB), so it
# never waits for a worker place behind 10-page PDFs. It can still wait for a call that is already running
# on a replica, for other small jobs, and for the one slot in SMALL_FIRST_BURST + 1 that goes to a large
# call. To run without it: `$DC up -d --scale worker-fast=0` or `$DC stop worker-fast`.
# Either is safe: the api sends a job to the fast queue only while a fast worker is alive (its
# health-check key is in Redis); without one, small jobs take the default queue and the default worker.
# A job left WAITING on the fast queue when its worker dies is moved to the default queue by the default
# worker (looks every FAST_LANE_RESCUE_SECONDS, 0 = never; about 90 s); one that was RUNNING there is
# started again only when arq's in-progress key expires (about 18 minutes). In both lanes a small job's
# calls to the model services go before those of large jobs.
#SMALL_JOB_MAX_PAGES=1
#FAST_LANE_RESCUE_SECONDS=30
# The queue names: the default queue is arq's own name, the fast one is new. A worker serves the queue
# named by WORKER_QUEUE_NAME (compose sets worker-fast to the fast name); the health check follows it.
#WORKER_QUEUE_NAME=arq:queue
#WORKER_FAST_QUEUE_NAME=decimer:fast
#WORKER_FAST_MAX_JOBS=2
#WORKER_FAST_MEM_LIMIT=1g
#WORKER_FAST_CPUS=1

# --- limits and retention: the values of docs/ROADMAP.md §3 (the API's defaults), listed so that a
# deployment can see and change them. See api/README.md. ------------------------------------------
JOB_TTL_SECONDS=3600
MAX_PDF_PAGES=10
MAX_STRUCTURES=20
# The edge reads this too (compose passes it): its body limit is this plus 1 MB.
MAX_UPLOAD_MB=100
MAX_ACTIVE_JOBS_PER_IP=2
QUEUE_MAX=50
# The api container's memory limit (3.5 GB) is sized from INGEST_CONCURRENCY x INGEST_MEMORY_MB (default
# 1536) + about 0.5 GB: raise it with either.
INGEST_CONCURRENCY=2
INGEST_WAIT_SECONDS=20
INGEST_TIMEOUT_SECONDS=30

# --- reporting ----------------------------------------------------------------------------------
# Sentry or GlitchTip DSN; empty disables error reporting (TODO: which one). Nothing has a route
# out of the stack until an `egress` network is added for api and worker (compose.yaml).
SENTRY_DSN=
